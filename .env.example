# Copy to .env.local and fill in real values. Never commit .env.local.

# Absolute base URL of the app's API (Route Handlers under src/app/api/v1).
# Server Components fetch with absolute URLs, so this must point at the running app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Neon Postgres connection string used by Drizzle in the Route Handlers.
# Create a free database at https://neon.tech and paste its connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
